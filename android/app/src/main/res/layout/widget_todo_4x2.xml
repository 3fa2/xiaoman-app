<?xml version="1.0" encoding="utf-8"?>
<!-- 待办小组件 4x2：大数字头部 + 圆形[+] + 最多 3 条装饰条卡（点条目勾选）。
     RemoteViews 布局禁用裸 View/Space，全部用白名单控件。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/widget_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="待办"
            android:textSize="13sp"
            android:textColor="@color/widget_ink_soft" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_add"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_add_bg"
            android:gravity="center"
            android:text="+"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="@color/widget_add_fg" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="12dp" />

    <LinearLayout
        android:id="@+id/widget_row0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_item_bg"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <TextView
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:background="@drawable/widget_bar" />

        <TextView
            android:id="@+id/widget_title0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13.5sp"
            android:textColor="@color/widget_ink" />

        <TextView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="9dp"
            android:background="@drawable/widget_check_ring" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_item_bg"
        android:layout_marginTop="7dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <TextView
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:background="@drawable/widget_bar" />

        <TextView
            android:id="@+id/widget_title1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13.5sp"
            android:textColor="@color/widget_ink" />

        <TextView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="9dp"
            android:background="@drawable/widget_check_ring" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_item_bg"
        android:layout_marginTop="7dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <TextView
            android:layout_width="3dp"
            android:layout_height="14dp"
            android:background="@drawable/widget_bar" />

        <TextView
            android:id="@+id/widget_title2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13.5sp"
            android:textColor="@color/widget_ink" />

        <TextView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="9dp"
            android:background="@drawable/widget_check_ring" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="全部完成，休息一下"
        android:textSize="13sp"
        android:textColor="@color/widget_ink_soft" />
</LinearLayout>