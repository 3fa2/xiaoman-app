<?xml version="1.0" encoding="utf-8"?>
<!-- 心情打卡小组件 2x2（v5.8）：头部「今天心情」+ 4 列 × 2 行预设心情点。
     名字/颜色为静态资源；选中格由 Provider 叠 mood_dot_ring 描边圈。
     RemoteViews 白名单控件（LinearLayout/FrameLayout/TextView）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mood_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <TextView
        android:id="@+id/mood_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="今天心情"
        android:textSize="13sp"
        android:letterSpacing="0.02"
        android:textColor="@color/widget_ink_soft" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/mood_dot_0"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/mood_dot_0" />

                <TextView
                    android:id="@+id/mood_ring_0"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:visibility="gone"
                    android:background="@drawable/mood_dot_ring" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="开心"
                android:textSize="9sp"
                android:textColor="@color/widget_ink_soft" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/mood_dot_1"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/mood_dot_1" />

                <TextView
                    android:id="@+id/mood_ring_1"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:visibility="gone"
                    android:background="@drawable/mood_dot_ring" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="期待"
                android:textSize="9sp"
                android:textColor="@color/widget_ink_soft" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/mood_dot_2"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/mood_dot_2" />

                <TextView
                    android:id="@+id/mood_ring_2"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:visibility="gone"
                    android:background="@drawable/mood_dot_ring" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="平静"
                android:textSize="9sp"
                android:textColor="@color/widget_ink_soft" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/mood_dot_3"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/mood_dot_3" />

                <TextView
                    android:id="@+id/mood_ring_3"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:visibility="gone"
                    android:background="@drawable/mood_dot_ring" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="感动"
                android:textSize="9sp"
                android:textColor="@color/widget_ink_soft" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/mood_dot_4"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/mood_dot_4" />

                <TextView
                    android:id="@+id/mood_ring_4"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:visibility="gone"
                    android:background="@drawable/mood_dot_ring" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="疲惫"
                android:textSize="9sp"
                android:textColor="@color/widget_ink_soft" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/mood_dot_5"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/mood_dot_5" />

                <TextView
                    android:id="@+id/mood_ring_5"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:visibility="gone"
                    android:background="@drawable/mood_dot_ring" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="难过"
                android:textSize="9sp"
                android:textColor="@color/widget_ink_soft" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/mood_dot_6"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/mood_dot_6" />

                <TextView
                    android:id="@+id/mood_ring_6"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:visibility="gone"
                    android:background="@drawable/mood_dot_ring" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="焦虑"
                android:textSize="9sp"
                android:textColor="@color/widget_ink_soft" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/mood_dot_7"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/mood_dot_7" />

                <TextView
                    android:id="@+id/mood_ring_7"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:visibility="gone"
                    android:background="@drawable/mood_dot_ring" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="生气"
                android:textSize="9sp"
                android:textColor="@color/widget_ink_soft" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
